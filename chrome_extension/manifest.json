{
  "manifest_version": 3,
  "name": "ZenRip - Media Downloader",
  "version": "1.4",
  "description": "Download videos and audio from YouTube, Instagram and X.com with Zen-like simplicity using your ZenRip server.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "downloads",
    "cookies"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://*.instagram.com/*",
    "https://*.onrender.com/*",
    "https://*.hf.space/*",
    "https://*.ngrok-free.app/*",
    "https://*.ngrok.io/*",
    "https://*.sslip.io/*",
    "http://localhost/*"
  ]
}